# =============================================================================
# HireFlow AI - Root environment reference.
# Copy the relevant blocks into backend/.env and frontend/.env.local
# NEVER commit a filled-in .env file.
# =============================================================================

# ----------------------------- BACKEND (backend/.env) -----------------------
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL in any shared/production environment.
# A local SQLite fallback is used automatically when DATABASE_URL is unset,
# so the project runs with zero infrastructure for a demo.
# DATABASE_URL=postgresql+psycopg://hireflow:hireflow@localhost:5432/hireflow
# Supabase example:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# --- Hunar.ai Voice AI (SERVER SIDE ONLY - never expose to the browser) ------
HUNAR_API_KEY=
HUNAR_BASE_URL=https://api.voice.hunar.ai/external/v1
HUNAR_DEFAULT_LANGUAGE=ENGLISH
HUNAR_DEFAULT_VOICE_PERSONA=NEHA
# Optional: E.164 caller ID owned by your Hunar org. Omit to let Hunar pick one.
HUNAR_FROM_PHONE_NUMBER=
# Public base URL of THIS backend, used to build Hunar callback URLs.
PUBLIC_BACKEND_URL=http://localhost:8000
# Shared secret used to verify the X-Hunar-Signature webhook HMAC.
HUNAR_WEBHOOK_SECRET=

# --- People search provider --------------------------------------------------
# mock | pdl   (mock ships with the repo; pdl requires a key)
PEOPLE_SEARCH_PROVIDER=mock
PDL_API_KEY=

# --- LLM provider (JD parsing, evaluation, summaries) ------------------------
# anthropic | heuristic   (heuristic is deterministic and needs no key)
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Demo mode ---------------------------------------------------------------
# true  -> voice calls are always simulated by a clearly-labelled demo provider
# false -> real Hunar calls are attempted (requires a working HUNAR_API_KEY)
#
# Setting this to false is safe: the app still refuses to dial fabricated demo
# contact data, and if the Hunar key is missing, expired or unreachable it falls
# back to the demo provider automatically instead of failing.
DEMO_MODE=true

# ----------------------------- FRONTEND (frontend/.env.local) ---------------
# Server-side only: the Next.js route handler proxies browser traffic here,
# so the backend URL and every API key stay out of the client bundle.
BACKEND_API_URL=http://localhost:8000
